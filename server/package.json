{
  "name": "vc3-catat-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API Point of Sale VC3 Catat (Express + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "hash-password": "tsx src/scripts/hash-password.ts",
    "db:start": "node scripts/local-db.mjs",
    "db:stop": "node scripts/stop-local-db.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^16.15.0-beta.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
