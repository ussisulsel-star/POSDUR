{
  "name": "vc3-catat-pos",
  "private": true,
  "version": "1.0.0",
  "description": "VC3 Catat POS - Point of Sale multi-outlet (React + Vite) dengan REST API Express dan PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "install:server": "npm --prefix server install",
    "dev:server": "npm --prefix server run dev",
    "build:server": "npm --prefix server run build",
    "start:server": "npm --prefix server start",
    "typecheck:server": "npm --prefix server run typecheck",
    "db:start": "npm --prefix server run db:start",
    "db:stop": "npm --prefix server run db:stop"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
