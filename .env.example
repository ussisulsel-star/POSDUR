# ============================================================
# Konfigurasi Frontend (Vite)
# ============================================================
# Opsional: target proxy /api saat `npm run dev`
API_PROXY_TARGET=http://localhost:4000

# ============================================================
# Konfigurasi Backend API (server/)
# ============================================================
PORT=4000
DATABASE_URL=postgres://ketoko_user:ketoko_secure_password_99999@localhost:5432/ketoko_pos_db
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=10
DB_POOL_MAX=10

# PostgreSQL portable lokal (opsional, dipakai oleh `npm run db:start`)
# Nilai default sudah sama dengan DATABASE_URL di atas.
# PGPORT=5432
# PGUSER=ketoko_user
# PGPASSWORD=ketoko_secure_password_99999
# PGDATABASE=ketoko_pos_db

# ============================================================
# Docker Compose (opsional, override nilai default)
# ============================================================
# POSTGRES_DB=ketoko_pos_db
# POSTGRES_USER=ketoko_user
# POSTGRES_PASSWORD=ketoko_secure_password_99999
# POSTGRES_PORT=5432
# API_PORT=4000
# WEB_PORT=3000
